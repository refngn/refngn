# Refined Engine / refngn
# Example site configuration for 0.4.7 Alpha

[site]
name = "example.com"
server_names = ["example.com", "www.example.com"]
document_root = "/home/web/example.com/public"
index = ["index.html"]
follow_symlinks = false
max_file_bytes = 67108864

[site.tls]
enabled = true
default = false
certificate = "/etc/refngn/config/certs/example.com-fullchain.pem"
private_key = "/etc/refngn/config/private/example.com.key"

[site.redirect]
http_to_https = true
https_port = 443
# target_domain = "www.example.com"

[site.security]
enabled = true
profile = "default"

# Optional route-specific security profile.
[[site.security.route]]
path_prefix = "/login"
profile = "strict"

[site.limits]
max_header_bytes = 32768
max_headers = 100
max_uri_bytes = 8192
request_body_bytes = 16777216
header_timeout_seconds = 10
body_timeout_seconds = 60
idle_timeout_seconds = 75

[site.parser]
# hyper = stable; hyper-custom/custom = experimental refngn-parser validation.
# HTTP parser modes:
#   hyper         = stable/default
#   hyper-custom  = Hyper + experimental refngn-parser validation
#   custom        = experimental custom validation
mode = "hyper"

[site.request_id]
enabled = true
header = "x-request-id"
trust_incoming = false

[site.headers]
strict_transport_security = "max-age=31536000; includeSubDomains"
x_content_type_options = "nosniff"
x_frame_options = "SAMEORIGIN"
referrer_policy = "strict-origin-when-cross-origin"
content_security_policy = "default-src 'self'"

[site.headers.set]
permissions-policy = "camera=(), microphone=()"

# Route-level fields must appear before [[site.proxy.multi.upstream]].
[[site.proxy]]
path_prefix = "/"
strip_prefix = false
timeout_seconds = 30
connect_timeout_seconds = 5
response_header_timeout_seconds = 30
idle_timeout_seconds = 75
max_request_body_bytes = 16777216
max_response_body_bytes = 268435456
streaming = true
websocket = true

# Structured IPv6 addresses are written without square brackets.
[[site.proxy.multi.upstream]]
protocol = "http"
address = "127.0.0.1"
port = 8090

[[site.proxy.multi.upstream]]
protocol = "http"
address = "::1"
port = 8090

[site.proxy.health_check]
enabled = true
path = "/health"
timeout_seconds = 2

[site.proxy.retry]
attempts = 2
retry_connect_errors = true

[site.proxy.headers]
host = "$host"
x_real_ip = "$remote_addr"
x_forwarded_for = "$proxy_add_x_forwarded_for"
x_forwarded_host = "$host"
x_forwarded_proto = "$scheme"

# Notes:
# - A single backend can use: upstream = "http://127.0.0.1:8090"
# - Do not combine upstream, upstreams and [[site.proxy.multi.upstream]] on one route.
# - HTTP/2 uses the same site routing as HTTP/1.1 when enabled globally.
# - HTTP/3 transport is experimental and feature-gated in 0.4.7 Alpha.
